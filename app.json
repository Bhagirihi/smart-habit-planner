{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1211"
      },
      "package": "com.smarthabit.planner.ui"
    },
    "name": "Smart Habit UI",
    "orientation": "portrait",
    "plugins": [
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "android": {
                "initialLayout": "./src/widgets/HabitWidget.tsx",
                "resizeMode": "both",
                "targetCellHeight": 4,
                "targetCellWidth": 4
              },
              "description": "Week at the top, then Habit completed today.",
              "displayName": "Smart Habit",
              "name": "HabitWidget"
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A1211"
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "smarthabitui",
    "slug": "smart-habit-ui",
    "userInterfaceStyle": "dark",
    "version": "1.0.2",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1211"
    }
  }
}